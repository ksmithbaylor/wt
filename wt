#!/usr/bin/env zsh
# wt - task-oriented git worktree manager

_WT_BOLD=$'\033[1m'
_WT_DIM=$'\033[2m'
_WT_RED=$'\033[31m'
_WT_GREEN=$'\033[32m'
_WT_YELLOW=$'\033[33m'
_WT_CYAN=$'\033[36m'
_WT_RESET=$'\033[0m'

_WT_GIT_MIN_MAJOR=2
_WT_GIT_MIN_MINOR=48
_WT_LS_CONCURRENCY=32

_wt_err()  { printf "${_WT_RED}error:${_WT_RESET} %s\n" "$*" >&2; }
_wt_warn() { printf "${_WT_YELLOW}warning:${_WT_RESET} %s\n" "$*" >&2; }
_wt_info() { printf "  ${_WT_DIM}%s${_WT_RESET}\n" "$*" >&2; }
_wt_ok()   { printf "  ${_WT_GREEN}%s${_WT_RESET}\n" "$*" >&2; }

_wt_git_ge() {
  local version major minor
  version=$(git version 2>/dev/null | awk '{print $3}') || return 1
  major=${version%%.*}
  minor=${version#*.}
  minor=${minor%%.*}
  [[ "$major" == <-> && "$minor" == <-> ]] || return 1
  (( major > $1 || (major == $1 && minor >= $2) ))
}

_wt_require_git() {
  _wt_git_ge "$_WT_GIT_MIN_MAJOR" "$_WT_GIT_MIN_MINOR" && return 0
  _wt_err "git >= ${_WT_GIT_MIN_MAJOR}.${_WT_GIT_MIN_MINOR} required (found: $(git version 2>/dev/null | awk '{print $3}'))"
  _wt_info "wt uses relative worktree paths, which require git ${_WT_GIT_MIN_MAJOR}.${_WT_GIT_MIN_MINOR}+."
  return 1
}

_wt_emit_cd() {
  if { true >&3 } 2>/dev/null; then
    printf '%s' "$1" >&3
  else
    _wt_info "would cd to: $1  (run 'eval \"\$(wt shell-init)\"' to enable auto-cd)"
  fi
}

_wt_root() {
  local common gitdir relative root
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)

  if [[ -z "$common" ]]; then
    gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null) || {
      _wt_err "not inside a git repository"
      return 1
    }
    if [[ -f "$gitdir/commondir" ]]; then
      relative=$(< "$gitdir/commondir")
      common=$(cd "$gitdir/$relative" 2>/dev/null && pwd) || {
        _wt_err "could not resolve commondir"
        return 1
      }
    else
      common="$gitdir"
    fi
  fi

  root=$(dirname "$common")
  if [[ ! -d "$root/.bare" ]]; then
    _wt_err "not a wt-managed repository (no .bare found)"
    return 1
  fi
  printf '%s' "$root"
}

_wt_validate_task() {
  local task="$1"
  [[ -n "$task" ]] || { _wt_err "task name cannot be empty"; return 1; }
  [[ "$task" != -* ]] || { _wt_err "task names cannot begin with '-': $task"; return 1; }
  [[ "$task" != */* ]] || { _wt_err "task names cannot contain '/': $task"; return 1; }
  case "$task" in
    .|..|.git|.bare|bin)
      _wt_err "reserved task name: $task"
      return 1
      ;;
  esac
  git check-ref-format "refs/wt/tasks/$task/base" >/dev/null 2>&1 || {
    _wt_err "invalid task name: $task"
    return 1
  }
}

_wt_validate_new_task() {
  local root="$1" task="$2" worktree_path="$root/$task"
  _wt_validate_task "$task" || return 1
  [[ ! -e "$worktree_path" ]] || { _wt_err "path already exists: $worktree_path"; return 1; }
}

_wt_registered_path() {
  local root="$1" expected="$2" line
  while IFS= read -r line; do
    [[ "$line" == worktree\ * ]] || continue
    [[ "${line#worktree }" == "$expected" ]] && return 0
  done < <(git -C "$root" worktree list --porcelain)
  return 1
}

_wt_task_path() {
  local root="$1" task="$2" worktree_path="$root/$task"
  _wt_validate_task "$task" || return 1
  _wt_registered_path "$root" "$worktree_path" || {
    _wt_err "no worktree for task '$task'"
    return 1
  }
  printf '%s' "$worktree_path"
}

_wt_current_task() {
  local root="$1" top
  top=$(git rev-parse --show-toplevel 2>/dev/null) || {
    _wt_err "not inside a task worktree"
    return 1
  }
  [[ "$(dirname "$top")" == "$root" ]] && _wt_registered_path "$root" "$top" || {
    _wt_err "not inside a task worktree"
    return 1
  }
  basename "$top"
}

_wt_source_worktree() {
  local root="$1" destination="$2" line candidate_path="" bare=""
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) candidate_path="${line#worktree }"; bare="" ;;
      bare) bare=1 ;;
      "")
        if [[ -z "$bare" && -n "$candidate_path" && "$candidate_path" != "$destination" && -d "$candidate_path" ]]; then
          printf '%s' "$candidate_path"
          return 0
        fi
        candidate_path=""
        bare=""
        ;;
    esac
  done < <(git -C "$root" worktree list --porcelain; printf '\n')
  return 1
}

_wt_setup_status_file() {
  local worktree_path="$1" gitdir pointer
  if [[ -f "$worktree_path/.git" ]]; then
    pointer=$(< "$worktree_path/.git")
    if [[ "$pointer" == "gitdir: "* ]]; then
      gitdir="${pointer#gitdir: }"
      [[ "$gitdir" == /* ]] || gitdir="$worktree_path/$gitdir"
      printf '%s/wt-setup-status' "$gitdir"
      return 0
    fi
  fi
  gitdir=$(git -C "$worktree_path" rev-parse --absolute-git-dir 2>/dev/null) || return 1
  printf '%s/wt-setup-status' "$gitdir"
}

_wt_set_setup_status() {
  local worktree_path="$1" setup_state="$2" file
  file=$(_wt_setup_status_file "$worktree_path") || return 0
  printf '%s\n' "$setup_state" > "$file"
}

_wt_setup_status() {
  local worktree_path="$1" file
  file=$(_wt_setup_status_file "$worktree_path") || { printf 'unknown'; return; }
  if [[ -f "$file" ]]; then
    printf '%s' "$(< "$file")"
  else
    printf 'not-run'
  fi
}

_wt_run_setup() {
  local root="$1" task="$2" worktree_path="$3" setup source=""
  setup=$(git -C "$root" config --get wt.setupcommand 2>/dev/null)
  if [[ -z "$setup" ]]; then
    _wt_info "No setup command configured."
    _wt_set_setup_status "$worktree_path" ready
    return 0
  fi

  source=$(_wt_source_worktree "$root" "$worktree_path" 2>/dev/null) || source=""
  _wt_info "Running setup for '$task'..."
  (
    export WT_ROOT="$root"
    export WT_TASK="$task"
    export WT_WORKTREE="$worktree_path"
    export WT_SOURCE_WORKTREE="$source"
    cd "$worktree_path" || exit 1
    /bin/sh -c "$setup"
  )
  local result=$?

  if (( result == 0 )); then
    _wt_set_setup_status "$worktree_path" ready
    _wt_ok "Setup complete."
  else
    _wt_set_setup_status "$worktree_path" failed
    _wt_err "setup failed; fix the problem and retry with 'wt setup $task'"
  fi
  return $result
}

_wt_default_branch() {
  local root="$1" branch
  branch=$(git -C "$root/.bare" symbolic-ref --short HEAD 2>/dev/null) || branch="main"
  printf '%s' "$branch"
}

_wt_base_ref() {
  local root="$1" base
  base=$(git -C "$root" config --get wt.baseref 2>/dev/null)
  if [[ -z "$base" ]]; then
    base="origin/$(_wt_default_branch "$root")"
    _wt_warn "wt.baseref is not configured; using $base"
  fi
  printf '%s' "$base"
}

_wt_fetch_ref() {
  local root="$1" ref="$2" remote="${ref%%/*}"
  [[ "$remote" != "$ref" ]] || return 0
  git -C "$root" remote get-url "$remote" >/dev/null 2>&1 || return 0
  _wt_info "Fetching $remote..."
  git -C "$root" fetch --quiet "$remote"
}

_wt_resolve_commit() {
  local root="$1" ref="$2"
  git -C "$root" rev-parse --verify "$ref^{commit}" 2>/dev/null || {
    _wt_err "could not resolve commit: $ref"
    return 1
  }
}

_wt_clone() {
  [[ "$1" == -h || "$1" == --help ]] && { _wt_help_topic clone; return; }
  [[ $# -gt 0 ]] || { _wt_err "usage: wt clone <url> [dir]"; return 1; }

  local url="$1" dir="${2:-$(basename "$1" .git)}"
  printf "\n${_WT_BOLD}Cloning${_WT_RESET} %s\n" "$url" >&2

  mkdir -p "$dir" || { _wt_err "could not create: $dir"; return 1; }
  git clone --bare "$url" "$dir/.bare" || return 1
  printf 'gitdir: ./.bare\n' > "$dir/.git"

  git -C "$dir/.bare" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
  git -C "$dir/.bare" config worktree.useRelativePaths true
  git -C "$dir/.bare" config wt.layout task-worktrees

  _wt_info "Fetching origin..."
  git -C "$dir" fetch --quiet origin || return 1

  local default
  default=$(_wt_default_branch "$dir")
  git -C "$dir/.bare" config wt.baseref "origin/$default"

  mkdir -p "$dir/bin" || return 1
  cat > "$dir/bin/setup" <<'EOF'
#!/bin/sh
printf 'No setup steps are configured for this repository.\nEdit %s/bin/setup to add them.\n' "$WT_ROOT"
EOF
  chmod +x "$dir/bin/setup"
  git -C "$dir/.bare" config wt.setupcommand 'exec "$WT_ROOT/bin/setup"'

  _wt_ok "Ready. Base ref: origin/$default"
  local destination
  destination=$(cd "$dir" 2>/dev/null && pwd) || destination="$dir"
  _wt_emit_cd "$destination"
}

_wt_add_fork() {
  [[ "$1" == -h || "$1" == --help ]] && { _wt_help_topic add-fork; return; }
  [[ $# -gt 0 ]] || { _wt_err "usage: wt add-fork <url>"; return 1; }

  local url="$1" root default
  root=$(_wt_root) || return 1
  git -C "$root" remote get-url origin >/dev/null 2>&1 || {
    _wt_err "no 'origin' remote found to rename"
    return 1
  }
  default=$(_wt_default_branch "$root")

  _wt_info "Renaming origin to upstream..."
  git -C "$root" remote rename origin upstream || return 1
  _wt_info "Adding fork as origin..."
  git -C "$root" remote add origin "$url" || return 1
  git -C "$root" config remote.pushDefault origin
  git -C "$root" config wt.baseref "upstream/$default"
  _wt_info "Fetching origin..."
  git -C "$root" fetch --quiet origin || return 1
  _wt_ok "Base ref: upstream/$default. Push remote: origin."
}

_wt_start() {
  [[ "$1" == -h || "$1" == --help ]] && { _wt_help_topic start; return; }
  [[ $# -gt 0 ]] || { _wt_err "usage: wt start <task> [-b <branch>] [--from <ref>]"; return 1; }

  local task="$1" branch="" from="" root worktree_path base setup_result
  shift
  while (( $# > 0 )); do
    case "$1" in
      -b|--branch)
        [[ $# -ge 2 ]] || { _wt_err "$1 requires a branch"; return 1; }
        branch="$2"
        shift 2
        ;;
      --from)
        [[ $# -ge 2 ]] || { _wt_err "--from requires a ref"; return 1; }
        from="$2"
        shift 2
        ;;
      *) _wt_err "unknown argument: $1"; return 1 ;;
    esac
  done

  root=$(_wt_root) || return 1
  _wt_validate_new_task "$root" "$task" || return 1
  if [[ -n "$branch" ]]; then
    git check-ref-format --branch "$branch" >/dev/null 2>&1 || {
      _wt_err "invalid branch name: $branch"
      return 1
    }
  fi

  base="${from:-$(_wt_base_ref "$root")}" || return 1
  _wt_fetch_ref "$root" "$base" || return 1
  _wt_resolve_commit "$root" "$base" >/dev/null || return 1
  worktree_path="$root/$task"

  if [[ -n "$branch" ]]; then
    _wt_info "Creating task '$task' on new branch '$branch' from $base..."
    git -C "$root" worktree add --no-track -b "$branch" "$worktree_path" "$base" || return 1
  else
    _wt_info "Creating task '$task' detached at $base..."
    git -C "$root" worktree add --detach "$worktree_path" "$base" || return 1
  fi

  _wt_run_setup "$root" "$task" "$worktree_path"
  setup_result=$?
  if [[ -z "$branch" ]]; then
    _wt_info "Detached at $base. Create or switch to a branch before committing."
  fi
  _wt_emit_cd "$worktree_path"
  return $setup_result
}

_wt_drop_stash() {
  local object="$1" selector
  selector=$(git stash list --format='%gd %H' | awk -v object="$object" '$2 == object { print $1; exit }')
  [[ -n "$selector" ]] || return 1
  git stash drop --quiet "$selector"
}

_wt_restore_stash() {
  local object="$1"
  if git stash apply "$object"; then
    _wt_drop_stash "$object" || _wt_warn "restored changes, but could not remove their stash entry"
  else
    _wt_err "could not restore the stash automatically; it remains in 'git stash list'"
  fi
}

_wt_save() {
  [[ "$1" == -h || "$1" == --help ]] && { _wt_help_topic save; return; }
  [[ $# -gt 0 ]] || { _wt_err "usage: wt save <task> [-b <branch>]"; return 1; }

  local task="$1" branch="" root worktree_path start stash_object setup_result
  shift
  while (( $# > 0 )); do
    case "$1" in
      -b|--branch)
        [[ $# -ge 2 ]] || { _wt_err "$1 requires a branch"; return 1; }
        branch="$2"
        shift 2
        ;;
      *) _wt_err "unknown argument: $1"; return 1 ;;
    esac
  done
  [[ -n "$branch" ]] || branch="$task"

  root=$(_wt_root) || return 1
  [[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" == true ]] || {
    _wt_err "wt save must be run inside a worktree"
    return 1
  }
  _wt_validate_new_task "$root" "$task" || return 1
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || {
    _wt_err "invalid branch name: $branch"
    return 1
  }
  [[ -n "$(git status --porcelain --ignore-submodules=none 2>/dev/null)" ]] || {
    _wt_err "no local changes to save"
    return 1
  }

  start=$(git rev-parse --verify HEAD 2>/dev/null) || {
    _wt_err "could not resolve current HEAD"
    return 1
  }
  _wt_info "Stashing changes..."
  git stash push --include-untracked -m "wt save: $task" >/dev/null || return 1
  stash_object=$(git rev-parse --verify refs/stash) || return 1
  worktree_path="$root/$task"

  _wt_info "Creating task '$task' on new branch '$branch'..."
  if ! git -C "$root" worktree add -b "$branch" "$worktree_path" "$start"; then
    _wt_err "worktree creation failed; restoring changes"
    _wt_restore_stash "$stash_object"
    return 1
  fi

  _wt_run_setup "$root" "$task" "$worktree_path"
  setup_result=$?

  _wt_info "Applying saved changes..."
  if ! git -C "$worktree_path" stash apply "$stash_object"; then
    _wt_err "stash application failed; the stash was kept"
    _wt_emit_cd "$worktree_path"
    return 1
  fi
  _wt_drop_stash "$stash_object" || _wt_warn "changes were moved, but their stash entry could not be removed"
  _wt_emit_cd "$worktree_path"
  return $setup_result
}

_wt_detached_head_is_reachable() {
  local root="$1" worktree_path="$2" head
  git -C "$worktree_path" symbolic-ref --quiet HEAD >/dev/null 2>&1 && return 0
  head=$(git -C "$worktree_path" rev-parse --verify HEAD) || return 1
  [[ -n "$(git -C "$root" for-each-ref --format='%(refname)' --contains "$head" refs 2>/dev/null)" ]]
}

_wt_finish() {
  [[ "$1" == -h || "$1" == --help ]] && { _wt_help_topic finish; return; }
  local task="" force="" argument root worktree_path current top remove_result internal_ref
  for argument in "$@"; do
    case "$argument" in
      -f|--force) force=1 ;;
      -*) _wt_err "unknown argument: $argument"; return 1 ;;
      *)
        [[ -z "$task" ]] || { _wt_err "only one task may be specified"; return 1; }
        task="$argument"
        ;;
    esac
  done

  root=$(_wt_root) || return 1
  [[ -n "$task" ]] || task=$(_wt_current_task "$root") || return 1
  worktree_path=$(_wt_task_path "$root" "$task") || return 1

  if [[ -z "$force" && -n "$(git -C "$worktree_path" status --porcelain --ignore-submodules=none 2>/dev/null)" ]]; then
    _wt_err "task '$task' has uncommitted changes; use -f to discard them"
    return 1
  fi
  if [[ -z "$force" ]] && ! _wt_detached_head_is_reachable "$root" "$worktree_path"; then
    _wt_err "task '$task' has detached commits not reachable from any ref"
    _wt_info "create a branch or use -f to remove it anyway"
    return 1
  fi

  current=$(pwd -P 2>/dev/null || pwd)
  top=$(cd "$worktree_path" 2>/dev/null && pwd -P)
  if [[ -n "$force" ]]; then
    git -C "$root" worktree remove --force --force "$worktree_path"
  else
    git -C "$root" worktree remove --force "$worktree_path"
  fi
  remove_result=$?
  (( remove_result == 0 )) || return $remove_result

  internal_ref="refs/wt/tasks/$task/base"
  git -C "$root" update-ref -d "$internal_ref" 2>/dev/null || true
  _wt_ok "Removed $task/. Branches were kept."
  if [[ "$current" == "$top" || "$current" == "$top/"* ]]; then
    _wt_emit_cd "$root"
  fi
}

_wt_setup() {
  [[ "$1" == -h || "$1" == --help ]] && { _wt_help_topic setup; return; }
  local root task worktree_path
  root=$(_wt_root) || return 1
  if [[ $# -gt 0 ]]; then
    [[ $# -eq 1 ]] || { _wt_err "usage: wt setup [<task>]"; return 1; }
    task="$1"
  else
    task=$(_wt_current_task "$root") || return 1
  fi
  worktree_path=$(_wt_task_path "$root" "$task") || return 1
  _wt_run_setup "$root" "$task" "$worktree_path"
}

_wt_ls() {
  setopt localoptions nobgnice
  [[ "$1" == -h || "$1" == --help ]] && { _wt_help_topic ls; return; }
  local root current raw worktree_path="" hash="" checkout="" bare="" line
  root=$(_wt_root) || return 1
  current=$(pwd -P 2>/dev/null || pwd)
  raw=$(git -C "$root" worktree list --porcelain) || return 1

  local -a worktree_paths hashes checkouts tasks states current_rows
  local index task state setup first_change base base_hash resolved
  local status_dir pid
  local -a batch_pids

  while IFS= read -r line; do
    case "$line" in
      worktree\ *) worktree_path="${line#worktree }"; bare="" ;;
      HEAD\ *) hash="${line#HEAD }" ;;
      branch\ *) checkout="${line#branch refs/heads/}" ;;
      detached) checkout="detached" ;;
      bare) bare=1 ;;
      "")
        if [[ -z "$bare" && -n "$worktree_path" && -n "$checkout" ]]; then
          worktree_paths+=("$worktree_path")
          hashes+=("$hash")
          checkouts+=("$checkout")
        fi
        worktree_path=""; hash=""; checkout=""; bare=""
        ;;
    esac
  done < <(printf '%s\n\n' "$raw")

  base=$(_wt_base_ref "$root" 2>/dev/null)
  base_hash=$(git -C "$root" rev-parse --verify "$base^{commit}" 2>/dev/null)
  status_dir=$(mktemp -d "${TMPDIR:-/tmp}/wt-ls.XXXXXX") || {
    _wt_err "could not create temporary directory"
    return 1
  }

  for (( index = 1; index <= ${#worktree_paths}; index++ )); do
    worktree_path="${worktree_paths[$index]}"
    task=$(basename "$worktree_path")
    tasks+=("$task")
    setup=$(_wt_setup_status "$worktree_path")
    resolved=$(cd "$worktree_path" 2>/dev/null && pwd -P || printf '%s' "$worktree_path")
    if [[ "$resolved" == "$current" || "$current" == "$resolved/"* ]]; then
      current_rows+=(1)
    else
      current_rows+=(0)
    fi
    if [[ "${checkouts[$index]}" == detached ]]; then
      [[ "$base_hash" == "${hashes[$index]}" ]] && checkouts[$index]="@$base" || checkouts[$index]="(detached)"
    fi

    (
      first_change=""
      IFS= read -r first_change < <(git -C "$worktree_path" status --porcelain --ignore-submodules=none 2>/dev/null)
      if [[ -n "$first_change" ]]; then
        printf 'dirty\n' > "$status_dir/$index"
      elif [[ "$setup" == failed ]]; then
        printf 'setup-failed\n' > "$status_dir/$index"
      elif [[ "$setup" == not-run ]]; then
        printf 'setup-pending\n' > "$status_dir/$index"
      else
        printf 'clean\n' > "$status_dir/$index"
      fi
    ) &
    batch_pids+=($!)

    if (( ${#batch_pids} == _WT_LS_CONCURRENCY )); then
      for pid in $batch_pids; do wait "$pid"; done
      batch_pids=()
    fi
  done
  for pid in $batch_pids; do wait "$pid"; done

  for (( index = 1; index <= ${#worktree_paths}; index++ )); do
    if [[ -f "$status_dir/$index" ]]; then
      states+=("$(< "$status_dir/$index")")
    else
      states+=("unknown")
    fi
  done
  command rm -rf -- "$status_dir"

  local task_width=4 checkout_width=8 state_width=5
  for (( index = 1; index <= ${#tasks}; index++ )); do
    (( ${#tasks[$index]} > task_width )) && task_width=${#tasks[$index]}
    (( ${#checkouts[$index]} > checkout_width )) && checkout_width=${#checkouts[$index]}
    (( ${#states[$index]} > state_width )) && state_width=${#states[$index]}
  done

  local table_width=$(( task_width + checkout_width + state_width + 13 ))
  echo
  printf "   ${_WT_BOLD}%-*s  %-*s  %-*s  %s${_WT_RESET}\n" \
    "$task_width" "task" "$checkout_width" "checkout" "$state_width" "state" "commit"
  printf "   ${_WT_DIM}"
  printf -- '-%.0s' {1..$table_width}
  printf "${_WT_RESET}\n"
  for (( index = 1; index <= ${#tasks}; index++ )); do
    if (( current_rows[$index] )); then
      printf " ${_WT_GREEN}* %-*s${_WT_RESET}  ${_WT_CYAN}%-*s${_WT_RESET}  %-*s  ${_WT_DIM}%s${_WT_RESET}\n" \
        "$task_width" "${tasks[$index]}" "$checkout_width" "${checkouts[$index]}" \
        "$state_width" "${states[$index]}" "${hashes[$index]:0:7}"
    else
      printf "   ${_WT_CYAN}%-*s${_WT_RESET}  %-*s  %-*s  ${_WT_DIM}%s${_WT_RESET}\n" \
        "$task_width" "${tasks[$index]}" "$checkout_width" "${checkouts[$index]}" \
        "$state_width" "${states[$index]}" "${hashes[$index]:0:7}"
    fi
  done
  echo
}

_wt_cd() {
  [[ "$1" == -h || "$1" == --help ]] && { _wt_help_topic cd; return; }
  [[ $# -eq 1 ]] || { _wt_err "usage: wt cd <task>"; return 1; }
  local root target
  root=$(_wt_root) || return 1
  target=$(_wt_task_path "$root" "$1") || return 1
  _wt_emit_cd "$target"
}

_wt_path() {
  [[ "$1" == -h || "$1" == --help ]] && { _wt_help_topic path; return; }
  local root target
  root=$(_wt_root) || return 1
  if [[ $# -eq 0 ]]; then
    printf '%s\n' "$root"
    return 0
  fi
  [[ $# -eq 1 ]] || { _wt_err "usage: wt path [<task>]"; return 1; }
  target=$(_wt_task_path "$root" "$1") || return 1
  printf '%s\n' "$target"
}

_wt_fetch() {
  [[ "$1" == -h || "$1" == --help ]] && { _wt_help_topic fetch; return; }
  local root
  root=$(_wt_root) || return 1
  _wt_info "Fetching all remotes..."
  git -C "$root" fetch --all
}

_wt_pr() {
  [[ "$1" == -h || "$1" == --help ]] && { _wt_help_topic pr; return; }
  [[ $# -ge 1 && $# -le 2 ]] || { _wt_err "usage: wt pr <number> [<task>]"; return 1; }

  local number="$1" task="${2:-pr-$1}" root remote worktree_path internal_ref
  [[ "$number" == <-> ]] || { _wt_err "invalid PR number: $number"; return 1; }
  root=$(_wt_root) || return 1
  _wt_validate_new_task "$root" "$task" || return 1

  if git -C "$root" remote get-url upstream >/dev/null 2>&1; then
    remote=upstream
  else
    remote=origin
  fi

  worktree_path="$root/$task"
  internal_ref="refs/wt/tasks/$task/base"
  _wt_info "Fetching PR #$number from $remote..."
  git -C "$root" fetch "$remote" "+refs/pull/$number/head:$internal_ref" || return 1
  if ! git -C "$root" worktree add --detach "$worktree_path" "$internal_ref"; then
    git -C "$root" update-ref -d "$internal_ref" 2>/dev/null || true
    return 1
  fi
  _wt_set_setup_status "$worktree_path" not-run
  _wt_ok "PR #$number -> $task/ (setup not run)"
  _wt_info "Run 'wt setup $task' after reviewing the PR's setup requirements."
  _wt_emit_cd "$worktree_path"
}

_wt_prune() {
  [[ "$1" == -h || "$1" == --help ]] && { _wt_help_topic prune; return; }
  local root
  root=$(_wt_root) || return 1
  git -C "$root" worktree prune -v

  local internal_ref task
  for internal_ref in ${(f)"$(git -C "$root" for-each-ref --format='%(refname)' refs/wt/tasks)"}; do
    task="${internal_ref#refs/wt/tasks/}"
    task="${task%/base}"
    if ! _wt_registered_path "$root" "$root/$task"; then
      git -C "$root" update-ref -d "$internal_ref"
      _wt_info "Removed stale task ref: $internal_ref"
    fi
  done
  _wt_ok "Done."
}

_wt_shell_init() {
  cat <<'WTEOF'
wt() {
  local _wt_target _wt_rc
  { _wt_target=$(command wt "$@" 3>&1 1>&4); _wt_rc=$?; } 4>&1
  [[ -n "$_wt_target" ]] && builtin cd -- "$_wt_target"
  return $_wt_rc
}
WTEOF
}

_wt_help_topic() {
  case "$1" in
    start)
      cat >&2 <<'EOF'
usage: wt start <task> [-b <branch>] [--from <ref>]

Create a task worktree, run setup, and cd into it. Without -b, HEAD is
detached at wt.baseref. --from overrides the configured base for this task.
EOF
      ;;
    save)
      cat >&2 <<'EOF'
usage: wt save <task> [-b <branch>]

Move current tracked and untracked changes into a new task worktree. The new
branch defaults to the task name and starts from the current HEAD.
EOF
      ;;
    finish)
      cat >&2 <<'EOF'
usage: wt finish [<task>] [-f]

Remove a task worktree while keeping every branch. Without a task, use the
current worktree. Refuses dirty worktrees and unreachable detached commits;
-f discards those safeguards.
EOF
      ;;
    setup)
      cat >&2 <<'EOF'
usage: wt setup [<task>]

Run wt.setupcommand in a task worktree. Defaults to the current task and can
be retried after a failed setup.
EOF
      ;;
    pr)
      cat >&2 <<'EOF'
usage: wt pr <number> [<task>]

Create a detached task worktree at a GitHub PR head. The task defaults to
pr-<number>. Setup is not run automatically for PR code.
EOF
      ;;
    clone)
      cat >&2 <<'EOF'
usage: wt clone <url> [dir]

Create a bare repository with on-demand sibling worktrees. Also creates
bin/setup and configures wt.baseref and wt.setupcommand. No worktree is created.
EOF
      ;;
    add-fork) printf '%s\n' 'usage: wt add-fork <url>' 'Rename origin to upstream, add a fork as origin, and update wt.baseref.' >&2 ;;
    ls) printf '%s\n' 'usage: wt ls' 'List tasks, checkouts, setup/dirty state, and commits.' >&2 ;;
    cd) printf '%s\n' 'usage: wt cd <task>' 'Navigate to a task worktree.' >&2 ;;
    path) printf '%s\n' 'usage: wt path [<task>]' 'Print a task path, or the repository root with no task.' >&2 ;;
    fetch) printf '%s\n' 'usage: wt fetch' 'Fetch all remotes.' >&2 ;;
    prune) printf '%s\n' 'usage: wt prune' 'Remove stale Git worktree records.' >&2 ;;
    shell-init) printf '%s\n' 'usage: wt shell-init' 'Print the interactive shell wrapper.' >&2 ;;
    *) _wt_err "unknown command: $1"; return 1 ;;
  esac
}

_wt_help() {
  if [[ $# -gt 0 ]]; then
    _wt_help_topic "$1"
    return
  fi

  printf "\n${_WT_BOLD}wt${_WT_RESET}  task-oriented git worktree manager\n" >&2
  printf "\n  Worktrees belong to tasks, not branches. Switch branches normally inside them.\n" >&2

  printf "\n${_WT_YELLOW}TASKS${_WT_RESET}\n" >&2
  printf "  ${_WT_CYAN}%-48s${_WT_RESET} %s\n" \
    "wt start <task> [-b <branch>] [--from <ref>]" "Create a task worktree, run setup, cd in" \
    "wt save <task> [-b <branch>]"                 "Move current changes into a new task worktree" \
    "wt finish [<task>] [-f]"                      "Remove a task worktree; keep its branches" \
    "wt setup [<task>]"                            "Run or retry repository setup" \
    "wt pr <number> [<task>]"                      "Create a detached GitHub PR worktree" >&2

  printf "\n${_WT_YELLOW}NAVIGATION${_WT_RESET}\n" >&2
  printf "  ${_WT_CYAN}%-48s${_WT_RESET} %s\n" \
    "wt ls"                                        "List tasks, checkouts, and state" \
    "wt cd <task>"                                 "Navigate to a task worktree" \
    "wt path [<task>]"                             "Print a task path or repository root" >&2

  printf "\n${_WT_YELLOW}REPOSITORY${_WT_RESET}\n" >&2
  printf "  ${_WT_CYAN}%-48s${_WT_RESET} %s\n" \
    "wt clone <url> [dir]"                         "Clone the bare+sibling layout" \
    "wt add-fork <url>"                            "Configure upstream and fork remotes" \
    "wt fetch"                                     "Fetch all remotes" \
    "wt prune"                                     "Remove stale worktree records" \
    "wt shell-init"                                "Print the auto-cd shell wrapper" >&2

  printf "\n  ${_WT_DIM}Use 'wt help <command>' for details. Add eval \"\$(wt shell-init)\" to your shell rc.${_WT_RESET}\n\n" >&2
}

wt() {
  local command="${1:-}"
  [[ $# -gt 0 ]] && shift
  case "$command" in
    clone)      _wt_require_git && _wt_clone "$@" ;;
    add-fork)   _wt_add_fork "$@" ;;
    start)      _wt_require_git && _wt_start "$@" ;;
    save)       _wt_require_git && _wt_save "$@" ;;
    finish)     _wt_finish "$@" ;;
    setup)      _wt_setup "$@" ;;
    ls)         _wt_ls "$@" ;;
    cd)         _wt_cd "$@" ;;
    path)       _wt_path "$@" ;;
    fetch)      _wt_fetch "$@" ;;
    pr)         _wt_require_git && _wt_pr "$@" ;;
    prune)      _wt_prune "$@" ;;
    shell-init) _wt_shell_init "$@" ;;
    ""|-h|--help) _wt_help ;;
    help)       _wt_help "$@" ;;
    *)          _wt_err "unknown command: $command"; _wt_help; return 1 ;;
  esac
}

wt "$@"
